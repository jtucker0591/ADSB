#!/usr/bin/env bash
# Blocks a push if any commit being pushed adds/modifies a file that looks
# like a real secrets file, or a line that looks like a real (non-empty,
# non-placeholder) WiFi credential -- added after the 2026-09-21 incident
# where src/secrets.h.*.bak (real WiFi passwords for four networks) got
# committed and pushed to this public repo. This is a client-side backstop:
# it only protects pushes made from a machine that has run
#   git config core.hooksPath .githooks
# (see README.md). It is not a substitute for GitHub's own secret scanning
# / push protection (Settings > Code security) -- enable that too.
set -euo pipefail

remote="$1"
zero="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # branch/tag deletion, nothing to scan

    if [ "$remote_sha" = "$zero" ]; then
        base_arg="4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git empty tree sha
    else
        base_arg="$remote_sha"
    fi

    bad_paths=$(git diff --name-only --diff-filter=A "$base_arg" "$local_sha" 2>/dev/null \
        | grep -E '(^|/)secrets\.h(\..+)?$|\.bak$' || true)
    if [ -n "$bad_paths" ]; then
        echo "pre-push BLOCKED: these paths look like real secrets/backups, not allowed in $remote:" >&2
        echo "$bad_paths" | sed 's/^/    /' >&2
        blocked=1
    fi

    hits=$(git diff "$base_arg" "$local_sha" 2>/dev/null \
        | grep -E '^\+[[:space:]]*#define[[:space:]]+WIFI_(PASS|SSID)[0-9]?[[:space:]]+"[^"]+"' \
        | grep -vE '"(REDACTED|)"' || true)
    if [ -n "$hits" ]; then
        echo "pre-push BLOCKED: a commit in this push adds what looks like a real WiFi credential:" >&2
        echo "$hits" | sed 's/^/    /' >&2
        blocked=1
    fi
done

if [ "$blocked" = "1" ]; then
    echo >&2
    echo "Push aborted. If this is a false positive, fix the underlying file" >&2
    echo "instead of bypassing this -- --no-verify defeats the whole point." >&2
    exit 1
fi
exit 0
